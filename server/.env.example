# ---- Server ----
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect

# ---- Auth (generate long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# lax works when client and API share a site; use "none" (requires HTTPS) for cross-site deployments
COOKIE_SAMESITE=lax

# ---- University email verification ----
# Comma-separated list. Subdomains are allowed (cs.campusconnect.edu matches campusconnect.edu)
ALLOWED_EMAIL_DOMAINS=campusconnect.edu

# ---- Email (optional in development: links are printed to the server console when SMTP_HOST is empty) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CampusConnect <no-reply@campusconnect.edu>"

# ---- Cloudinary (optional in development: images are stored in server/uploads when empty) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
